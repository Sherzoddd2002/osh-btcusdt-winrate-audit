# Copy Demo Trading keys only. Never commit the actual root .env.
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# Keep false during API-connectivity test. Change to true only after confirming these are Demo keys.
OSH_ENABLE_DEMO_ORDERS=false
OSH_SYMBOL=BTCUSDT
OSH_POSITION_CAP_USD=50
OSH_MAX_DRAWDOWN_PCT=15
OSH_LOCAL_PORT=8765
OSH_MODEL_ARTIFACT=forward_paper_h96_c2_model.joblib
OSH_MODEL_LOCK=forward_paper_h96_c2_lock.json
